{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "useDefineForClassFields": false,
    "target": "ES2023",
    "types": ["node", "jest"],
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "strictPropertyInitialization": false,
    "paths": {
      "@config/*": ["./config/*"],
      "@libs/boat": ["./libs/boat/src"],
      "@libs/boat/*": ["./libs/boat/src/*"],
      "@libs/media-worker": ["./libs/media-worker/src"],
      "@libs/media-worker/*": ["./libs/media-worker/src/*"],
      "@libs/serverless": ["./libs/serverless/src"],
      "@libs/serverless/*": ["./libs/serverless/src/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
